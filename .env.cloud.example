# Template; configure as encrypted secrets in the cloud, NEVER commit your .env.
# The service is PAUSED until MODU_AUTOMATION_ENABLED=true.
MODU_AUTOMATION_ENABLED=false
MODU_DRY_RUN=true
MODU_SOURCE_TOKEN=
OPENAI_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
MODU_SPREADSHEET_ID=
STATUS_TOKEN=
OPENAI_MODEL=gpt-5.5
MODU_MAX_ROWS=10
MAX_DAILY_ROWS=100
CYCLE_INTERVAL_SECONDS=900
DISCOVERY_ENABLED=false
DISCOVERY_INTERVAL_SECONDS=14400
SHEET_NAME=EXPOSITORES | BASE ÚNICA
DATA_DIR=/data
